{
  "name": "Prepaid calculator",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "20" } },
  "forwardPorts": [8000],
  "portsAttributes": { "8000": { "label": "Calculator preview", "onAutoForward": "openPreview" } },
  "postAttachCommand": "python -m http.server 8000",
  "customizations": { "codespaces": { "openFiles": ["README.md", "index.html"] } }
}
